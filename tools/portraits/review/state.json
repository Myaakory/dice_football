  "shirt.field": {
   "batch": 1,
   "version": 8,
   "hash": "4279be7c55",
   "history": [
    {
     "version": 1,
     "date": "2026-10-30",
     "note": "szerszy dekolt i szyja w 64 px (twoja uwaga z 30.10)"
    },
    {
     "version": 2,
     "date": "2026-10-30",
     "note": "64 px: lamówka jest krawędzią dekoltu (bez drugiego, węższego V w środku), szyja pod koszulką szersza"
    },
    {
     "version": 3,
     "date": "2026-10-30",
     "note": "64 px: szyja rozszerza się ku ramionom i przechodzi prosto w krawędź kołnierza – bez węższego V szyi wewnątrz V dekoltu"
    },
    {
     "version": 4,
     "date": "2026-10-30",
     "note": "64 px: szyja prosta, stałej szerokości (bez rozszerzania od brody), wchodzi prosto w krawędź kołnierza; dekolt odpowiednio węższy"
    },
    {
     "version": 5,
     "date": "2026-10-30",
     "note": "64 px: zmieniony tylko dekolt – jeden prosty serek, który zaczyna się dokładnie na krawędziach szyi i schodzi do szpica bez załamania; szyja jak w pierwszej wersji"
    },
    {
     "version": 6,
     "date": "2026-10-30",
     "note": "64 px: dekolt zbudowany jak w 32 px – cienki kontur i lamówka 1 px, bez grubej lamówki i pasa cienia, które tworzyły drugie, szersze V; szyja bez zmian"
    },
    {
     "version": 7,
     "date": "2026-10-30",
     "note": "64 px: boki serka to prosta linia pod 45° od krawędzi szyi do szpica – bez załamania w połowie (zaznaczonego na czerwono)"
    },
    {
     "version": 8,
     "date": "2026-10-30",
     "note": "64 px: czubek serka 2 px niżej, wycięcie zaczyna się 1 px poza szyją (minimalnie szersze od szyi), boki dalej prosto pod 45°; szyja bez zmian"
    }
   ]
  },
